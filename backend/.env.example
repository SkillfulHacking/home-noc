# backend/.env.example  (patch)

# --- Administrator authentication (fail closed) ---------------------------
# There is no default password and no shared API key. With APP_ENV=prod the
# API refuses to start unless ADMIN_PASSWORD_HASH holds a valid verifier.
# Generate one interactively (the password is never stored or echoed):
#   python -m app.admin_password
# then paste the resulting line below in your real, untracked backend/.env.
ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH=pbkdf2_sha256$<iterations>$<salt>$<digest>

# Session lifetime (seconds): absolute TTL and inactivity timeout.
# SESSION_TTL_SECONDS=43200
# SESSION_IDLE_TIMEOUT_SECONDS=3600
# Cookies are Secure by default in production, so browsers only send them over
# HTTPS. Set to false ONLY when serving plain HTTP on a trusted loopback/LAN
# origin (e.g. http://192.168.x.x:3000). scripts/bootstrap.sh writes this
# explicitly (--http => false); it is never relaxed silently.
# SESSION_COOKIE_SECURE=true
# NOTE: Docker Compose interpolates '$' in env files, so the verifier MUST be in
# single quotes: ADMIN_PASSWORD_HASH='pbkdf2_sha256$600000$...$...'

# --- Connector credential encryption (M04) --------------------------------
# AES-256 key protecting stored UniFi/SNMPv3 credentials. It is NEVER generated
# by the app and must live OUTSIDE the SQLite volume and outside Git. Without
# it, credential endpoints return 503 (no plaintext fallback). Generate once:
#   python -c "import base64,secrets;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# With Docker Compose, scripts/bootstrap.sh creates secrets/credential_key and
# docker-compose.yml mounts it at /run/secrets/home_noc_credential_key and sets
# CREDENTIAL_ENCRYPTION_KEY_FILE for you. Do NOT also set CREDENTIAL_ENCRYPTION_KEY
# here (setting both makes the key unusable by design). Upgrading from M04 with an
# inline key? Move that SAME key to the file; see docs/installation.md. For non-Compose runs use
# one of the following. See docs/connector-credentials.md - losing the key makes
# every stored credential unrecoverable.
# CREDENTIAL_ENCRYPTION_KEY=<urlsafe-base64 of 32 random bytes>
# CREDENTIAL_ENCRYPTION_KEY_FILE=/run/secrets/home_noc_credential_key

# --- Authorized scan scope (M08, docs/scan-scope.md) ----------------------
# M08A: routine scan policy is now managed at runtime by an administrator in
# Settings > Security > Scan Policy; a fresh install needs NO scan variables.
# The two variables below are OPTIONAL immutable deployment CEILINGS that the
# UI can narrow but never widen (any applicable denial wins):
#  * SCAN_ALLOWED_CIDRS set    -> runtime policy is confined to these IPv4 CIDRs.
#    (Set but with no usable IPv4 entry -> every scan is refused.)
#  * SCAN_ALLOW_PUBLIC=false   -> public scanning cannot be enabled at runtime.
#    SCAN_ALLOW_PUBLIC=true never authorizes anything by itself; public targets
#    still need the admin opt-in AND an explicit public allowlist entry.
# Upgrading with SCAN_ALLOWED_CIDRS unset keeps scanning DISABLED until an
# administrator enables it (the pre-M08A behaviour is not silently broadened).
# SCAN_ALLOWED_CIDRS=192.168.50.0/24,10.20.0.0/22
# SCAN_ALLOW_PUBLIC=false
# Opt-in "security" profile (service/version detection). Keep off by default.
# SCAN_SECURITY_PROFILE_ENABLED=false

# --- Scan/poll worker (M09-M11, docs/scan-jobs.md) ------------------------
# All optional; defaults are conservative. Shown with their defaults.
# Scan jobs running at once across all workers (1-4):
# WORKER_MAX_CONCURRENT_JOBS=1
# Queued + running jobs before new starts get HTTP 429 (1-50):
# SCAN_MAX_ACTIVE_JOBS=5
# Attempts per job, first run included (1-5), and retry backoff base (seconds):
# SCAN_JOB_MAX_ATTEMPTS=3
# SCAN_JOB_RETRY_BACKOFF_SECONDS=5
# A job whose worker stops heartbeating for this long is recovered (seconds):
# WORKER_LEASE_SECONDS=30
# WORKER_POLL_INTERVAL_SECONDS=2
# WORKER_KILL_GRACE_SECONDS=5
# ICMP echo response window per address (0.1-10 seconds):
# SCAN_ICMP_PROBE_TIMEOUT_SECONDS=1
# TCP connect ports are operator configuration, not request input. The
# default has 20 common ports; duplicates, invalid values, and lists above
# SCAN_TCP_MAX_PORTS are rejected before any packet is sent.
# SCAN_TCP_PORTS=22,53,80,111,135,139,443,445,548,631,2049,3306,3389,5000,5432,5900,8000,8080,8443,9100
# SCAN_TCP_MAX_PORTS=20
# Actual socket calls are limited to 8 in flight by the ports profile and to
# this many starts per second. Each connect has its own response window; the
# profile also has a 900-second overall deadline.
# SCAN_TCP_CONNECTIONS_PER_SECOND=20
# SCAN_TCP_CONNECTION_TIMEOUT_SECONDS=1
# Absolute host x port work cap (the default is 256 x 20):
# SCAN_TCP_MAX_TOTAL_CONNECTIONS=5120

# CORS: JSON array or CSV (leave unset for disabled)
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

DATABASE_URL=sqlite:////data/home_noc.db
APP_NAME=home-noc
APP_ENV=prod

# Leave off; use Alembic for schema
AUTO_CREATE_TABLES=0
